      "source": "from collections import defaultdict\n\ndef group_anagrams(words):\n    # Create a dictionary to hold lists of words that are anagrams of each other\n    anagram_groups = defaultdict(list)\n    \n    # Iterate over each word in the input list\n    for word in words:\n        # Sort the characters in the word to form a key for grouping\n        sorted_word = ''.join(sorted(word))\n        \n        # Append the original word to the corresponding list in the dictionary\n        anagram_groups[sorted_word].append(word)\n    \n    # Convert the values in the dictionary to lists and sort them based on the first element of each sublist\n    return [sorted(group) for group in anagram_groups.values()]",
