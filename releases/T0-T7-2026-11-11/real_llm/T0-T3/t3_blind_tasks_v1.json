      "function": "stable_unique",
      "instruction": "Implement stable_unique(items). Input is a list of integers. Return a new list containing each distinct integer exactly once, preserving its first occurrence order. Do not modify the input.",
      "tests": [
        {
          "args": [
            [
              3,
              1,
              3,
              2,
              1
            ]
          ],
          "expected": [
            3,
            1,
            2
          ]
        },
        {
          "args": [
            []
          ],
          "expected": []
        },
        {
          "args": [
            [
              5,
              5,
              5
            ]
          ],
          "expected": [
            5
          ]
        },
        {
          "args": [
            [
              -1,
              0,
              -1,
              2
            ]
          ],
          "expected": [
            -1,
            0,
            2
          ]
        },
        {
          "args": [
            [
              4,
              2,
              4,
              1,
              2,
              3
            ]
          ],
          "expected": [
            4,
            2,
            1,
            3
          ]
        }
      ]
    },
