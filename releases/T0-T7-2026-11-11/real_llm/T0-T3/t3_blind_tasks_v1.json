    {
      "task_id": "T3_004",
      "function": "count_words",
      "instruction": "Implement count_words(text). Input is a string. Split words using whitespace, convert each word to lowercase, and return a dictionary mapping words to occurrence counts. Punctuation is part of a word and must not be removed.",
      "tests": [
        {
          "args": [
            "Red blue red"
          ],
          "expected": {
            "red": 2,
            "blue": 1
          }
        },
        {
          "args": [
            ""
          ],
          "expected": {}
        },
        {
          "args": [
            "Hi hi HI"
          ],
          "expected": {
            "hi": 3
          }
        },
        {
          "args": [
            "a, a"
          ],
          "expected": {
            "a,": 1,
            "a": 1
          }
        },
        {
          "args": [
            "  X\tY\nx  "
          ],
          "expected": {
            "x": 2,
            "y": 1
          }
        }
      ]
    },
